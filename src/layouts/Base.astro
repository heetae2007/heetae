---
import Footer from "../components/Footer.astro";
import { url } from "../lib/url.js";

const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{title}</title>
    <meta name="description" content={description}>

    <script is:inline>document.documentElement.classList.add("js")</script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&family=Noto+Serif+KR:wght@400;600;900&display=swap" rel="stylesheet">

    <link rel="icon" href={url("img/potato.svg")} type="image/svg+xml">
    <link rel="stylesheet" href={url("css/site.css")}>
</head>

<body>

    <slot />

    <Footer />

    <script is:inline src={url("js/site.js")}></script>

</body>
</html>
